# ============================================================
# Application
# ============================================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================================
# Discord
# ============================================================
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_EVENT_CHANNEL_ID=
DISCORD_DEATH_CHANNEL_ID=
DISCORD_PENDING_EVENT_LIMIT=500

DISCORD_STATUS_MESSAGE_ENABLED=false
DISCORD_STATUS_CHANNEL_ID=

DISCORD_GAME_CHAT_RENDERING=bot
DISCORD_GAME_CHAT_WEBHOOK_URL=
ESCAPE_GAME_CHAT_MARKDOWN=true

# ============================================================
# Conan RCON
# ============================================================
CONAN_RCON_HOST=127.0.0.1
CONAN_RCON_PORT=25575
CONAN_RCON_PASSWORD=
RCON_COMMAND_TIMEOUT_MILLISECONDS=5000
RCON_COMMAND_QUEUE_LIMIT=100

GAME_CHAT_TRANSPORT=automatic
GAME_CHAT_DISCORD_PREFIX=[Discord]
GAME_CHAT_MAXIMUM_CHARACTERS=400

# ============================================================
# Conan Logs
# ============================================================
CONAN_LOG_PATH=
CONAN_LOG_START_POSITION=end
GAME_CHAT_ALLOWED_CHANNELS=global
ALLOW_UNKNOWN_GAME_CHAT_CHANNEL=false

# ============================================================
# Chat Relay
# ============================================================
CHAT_RELAY_ENABLED=true
DISCORD_TO_GAME_CHAT_ENABLED=true
GAME_TO_DISCORD_CHAT_ENABLED=true
CHAT_USER_MESSAGE_LIMIT=5
CHAT_USER_MESSAGE_WINDOW_SECONDS=10
CHAT_GLOBAL_MESSAGE_LIMIT=30
CHAT_GLOBAL_MESSAGE_WINDOW_SECONDS=10
CHAT_ECHO_MEMORY_SECONDS=60
CHAT_ECHO_MAXIMUM_ENTRIES=1000

# ============================================================
# Player Tracking
# ============================================================
TRACK_PLAYERS=true
TRACK_PLAYER_SESSIONS=true
PUBLISH_JOIN_LEAVE_EVENTS=true
PLAYER_POLL_INTERVAL_SECONDS=30
PLAYER_MISSING_POLLS_BEFORE_LEAVE=2
SERVER_FAILURES_BEFORE_OFFLINE=3
SERVER_MAXIMUM_PLAYERS=

# ============================================================
# Death Tracking
# ============================================================
TRACK_PLAYER_DEATHS=true
PUBLISH_DEATH_EVENTS=true
DEATH_EVENT_DUPLICATE_WINDOW_SECONDS=10

# ============================================================
# Storage
# ============================================================
DATABASE_PATH=./data/hyborian-relay.db

# ============================================================
# Health Server
# ============================================================
HEALTH_SERVER_ENABLED=true
HEALTH_SERVER_HOST=127.0.0.1
HEALTH_SERVER_PORT=8787
